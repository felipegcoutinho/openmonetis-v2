{
  "name": "openmonetis",
  "version": "0.13.1",
  "description": "API-first self-hosted personal finance manager",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/felipegcoutinho/openmonetis-v2#readme",
  "bugs": {
    "url": "https://github.com/felipegcoutinho/openmonetis-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipegcoutinho/openmonetis-v2.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm db:migrations:check",
    "db:generate": "pnpm --filter @openmonetis/db db:generate",
    "db:migrations:check": "node scripts/validate-migrations.mjs",
    "db:migrate": "pnpm --filter @openmonetis/db db:migrate",
    "db:seed": "pnpm --filter @openmonetis/api db:seed",
    "db:studio": "pnpm --filter @openmonetis/db db:studio",
    "dev": "pnpm --parallel --filter @openmonetis/api --filter @openmonetis/web dev",
    "docker:build": "pnpm run \"/^docker:build:(api|migrator|web)$/\"",
    "docker:build:api": "docker build --target api --tag openmonetis-local/openmonetis-api:local .",
    "docker:build:migrator": "docker build --target migrator --tag openmonetis-local/openmonetis-migrator:local .",
    "docker:build:web": "docker build --target web --tag openmonetis-local/openmonetis-web:local .",
    "docker:config": "docker compose config",
    "docker:db": "docker compose up -d db",
    "docker:down": "docker compose down",
    "docker:pull": "docker compose pull",
    "docker:up": "docker compose up -d --pull always",
    "format": "biome format --write .",
    "lint": "biome check . && pnpm lint:ui",
    "lint:ui": "pnpm --filter @openmonetis/web lint:ui",
    "release:check": "node scripts/validate-release.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:tags:integration": "TAGS_INTEGRATION_TEST=1 tsx --test apps/api/src/repositories/tags.repository.integration.test.ts",
    "typecheck": "pnpm -r typecheck && pnpm --filter @openmonetis/web exec tsc -p ../../tsconfig.tests.json",
    "test:categories:integration": "CATEGORIES_INTEGRATION_TEST=1 tsx --test apps/api/src/repositories/categories.repository.integration.test.ts",
    "test:recurring:integration": "RECURRING_INTEGRATION_TEST=1 tsx --test apps/api/src/repositories/recurring-transactions.repository.integration.test.ts",
    "test:settlements:integration": "SETTLEMENTS_INTEGRATION_TEST=1 tsx --test apps/api/src/repositories/settlements.repository.integration.test.ts",
    "test:auth:integration": "AUTH_INTEGRATION_TEST=1 tsx --test apps/api/src/auth.integration.test.ts",
    "test:transactions:integration": "TRANSACTIONS_INTEGRATION_TEST=1 tsx --test apps/api/src/transactions.integration.test.ts",
    "test:connections:integration": "CONNECTIONS_INTEGRATION_TEST=1 tsx --test apps/api/src/person-connections.integration.test.ts",
    "test:imports:integration": "IMPORTS_INTEGRATION_TEST=1 tsx --test apps/api/src/imports.integration.test.ts",
    "test:settings:integration": "SETTINGS_INTEGRATION_TEST=1 tsx --test apps/api/src/settings.integration.test.ts",
    "test:ownership:integration": "OWNERSHIP_INTEGRATION_TEST=1 tsx --test apps/api/src/ownership.integration.test.ts",
    "test:migrations:integration": "MIGRATIONS_INTEGRATION_TEST=1 tsx --test apps/api/src/migrations.integration.test.ts",
    "test:storage:integration": "STORAGE_INTEGRATION_TEST=1 tsx --test apps/api/src/storage.integration.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "c8 node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:financial-distribution:integration": "FINANCIAL_DISTRIBUTION_INTEGRATION_TEST=1 tsx --test apps/api/src/financial-distribution.integration.test.ts",
    "test:financial-integrity:integration": "FINANCIAL_INTEGRITY_INTEGRATION_TEST=1 tsx --test apps/api/src/financial-integrity.integration.test.ts",
    "test:storage:live": "REAL_STORAGE_INTEGRATION_TEST=1 tsx --test apps/api/src/storage-real.integration.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "1.63.0",
    "c8": "10.1.3",
    "tsx": "^4.23.13"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
